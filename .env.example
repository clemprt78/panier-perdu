# À recopier dans Vercel → ton projet → Settings → Environment Variables
# (ne jamais mettre les vraies valeurs dans le code)

# Stripe → Développeurs → Clés API (mode test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Développeurs → Webhooks → ton endpoint → Clé secrète de signature
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend → API Keys
RESEND_API_KEY=re_...
# Ton email : tu reçois une alerte à chaque vente, et les clients te répondent ici
OWNER_EMAIL=
# Email affiché dans le pied de page et la garantie
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase → Project Settings → API Keys (et Data API pour l'URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
